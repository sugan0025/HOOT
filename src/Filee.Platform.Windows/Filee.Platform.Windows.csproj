<!--
  Filee.Platform.Windows: Windows implementation of IPlatformServices
  (Explorer detection & selection, context menu, auto-start, system metrics, .lnk shortcut targets).
  Targets plain net10.0 so the cross-platform app can reference it; every entry point is guarded
  with [SupportedOSPlatform("windows")] and only used when OperatingSystem.IsWindows() is true.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Filee.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFrameworks>net10.0;net10.0-windows10.0.17763.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants Condition="$(TargetFramework.StartsWith('net10.0-windows'))">$(DefineConstants);HOOT_WINRT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Filee.Core\Filee.Core.csproj" />
    <InternalsVisibleTo Include="Filee.Platform.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="WindowsMusicSessionWatcher.cs" />
  </ItemGroup>
</Project>
