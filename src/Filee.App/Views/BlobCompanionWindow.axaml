<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Filee.App.Controls"
        x:Class="Filee.App.Views.BlobCompanionWindow"
        Title=""
        Width="104" Height="104"
        MinWidth="104" MinHeight="104"
        MaxWidth="104" MaxHeight="104"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">
  <Window.Styles>
    <Style Selector="Button.music-transport">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Foreground" Value="#FFFAF8FF" />
    </Style>
    <Style Selector="Button.music-transport:pointerover">
      <Setter Property="Background" Value="#33796EE0" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.music-transport:pressed">
      <Setter Property="Background" Value="#55796EE0" />
    </Style>
  </Window.Styles>
  <Grid x:Name="Root" Background="Transparent" DragDrop.AllowDrop="True">
    <c:BlobatarControl x:Name="Blob" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsAnimated="True" MaxFramesPerSecond="30"
                       PointerReactionsEnabled="False" AudioEnabled="False" IsHitTestVisible="False"
                       RenderTransformOrigin="50%,50%" />
    <Canvas x:Name="SwallowLayer" IsHitTestVisible="False" ClipToBounds="False">
      <TextBlock x:Name="CompanionGlyph" Text="z" FontSize="14" FontWeight="Bold"
                 Foreground="#FF6E58A8" IsVisible="False" Opacity="0" />
      <Border x:Name="FileToken" Width="34" Height="30" CornerRadius="7" Padding="2"
              Background="#FFFDFEFF" BorderBrush="#FF6E58A8" BorderThickness="1"
              IsVisible="False" Opacity="0" RenderTransformOrigin="50%,50%">
        <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Border.RenderTransform>
        <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image x:Name="FileTokenIcon" Width="17" Height="17" Stretch="Uniform" IsVisible="False" />
          <TextBlock x:Name="FileTokenLabel" Text="FILE" FontSize="6" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF392B5A" />
        </StackPanel>
      </Border>
    </Canvas>
    <Popup x:Name="ThoughtPopup" PlacementTarget="{Binding #Blob}" Placement="Top"
           IsLightDismissEnabled="False" IsHitTestVisible="False">
      <StackPanel Spacing="4" HorizontalAlignment="Center">
        <Border x:Name="ThoughtCloud" MinWidth="112" MaxWidth="230" Padding="10,7"
                Background="#FFFDFEFF" BorderBrush="#FF6E58A8" BorderThickness="1.5"
                CornerRadius="18" ClipToBounds="True" BoxShadow="0 3 12 0 #550A0718" Opacity="0">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
            </Transitions>
          </Border.Transitions>
          <Grid ClipToBounds="True">
            <TextBlock x:Name="ThoughtText" Text="No files to feed me ??" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="#FF392B5A" FontSize="12" FontWeight="SemiBold" />
            <Canvas x:Name="MusicParticleCanvas" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" IsVisible="False" IsHitTestVisible="False" ClipToBounds="True">
              <Path x:Name="MusicParticle0" Width="12" Height="12" Stretch="Fill" Stroke="#FFFAFCFF" StrokeThickness="0.9" Opacity="0" RenderTransformOrigin="50%,50%"
                    Data="M8,0.7 L8,15.3 M1.7,4.5 L14.3,11.5 M14.3,4.5 L1.7,11.5 M8,3.2 L5.8,1.4 M8,3.2 L10.2,1.4 M8,12.8 L5.8,14.6 M8,12.8 L10.2,14.6 M4.4,6 L4.2,3.4 M4.4,6 L2,6.4 M11.6,6 L11.8,3.4 M11.6,6 L14,6.4 M4.4,10 L4.2,12.6 M4.4,10 L2,9.6 M11.6,10 L11.8,12.6 M11.6,10 L14,9.6" />
              <Path x:Name="MusicParticle1" Width="9" Height="9" Stretch="Fill" Stroke="#FFE8E3FF" StrokeThickness="0.9" Opacity="0" RenderTransformOrigin="50%,50%"
                    Data="M8,0.7 L8,15.3 M1.7,4.5 L14.3,11.5 M14.3,4.5 L1.7,11.5 M8,3.2 L5.8,1.4 M8,3.2 L10.2,1.4 M8,12.8 L5.8,14.6 M8,12.8 L10.2,14.6 M4.4,6 L4.2,3.4 M4.4,6 L2,6.4 M11.6,6 L11.8,3.4 M11.6,6 L14,6.4 M4.4,10 L4.2,12.6 M4.4,10 L2,9.6 M11.6,10 L11.8,12.6 M11.6,10 L14,9.6" />
              <Path x:Name="MusicParticle2" Width="11" Height="11" Stretch="Fill" Stroke="#FFDCD4FF" StrokeThickness="0.9" Opacity="0" RenderTransformOrigin="50%,50%"
                    Data="M8,0.7 L8,15.3 M1.7,4.5 L14.3,11.5 M14.3,4.5 L1.7,11.5 M8,3.2 L5.8,1.4 M8,3.2 L10.2,1.4 M8,12.8 L5.8,14.6 M8,12.8 L10.2,14.6 M4.4,6 L4.2,3.4 M4.4,6 L2,6.4 M11.6,6 L11.8,3.4 M11.6,6 L14,6.4 M4.4,10 L4.2,12.6 M4.4,10 L2,9.6 M11.6,10 L11.8,12.6 M11.6,10 L14,9.6" />
              <Path x:Name="MusicParticle3" Width="9" Height="9" Stretch="Fill" Stroke="#FFF1EEFF" StrokeThickness="0.9" Opacity="0" RenderTransformOrigin="50%,50%"
                    Data="M8,0.7 L8,15.3 M1.7,4.5 L14.3,11.5 M14.3,4.5 L1.7,11.5 M8,3.2 L5.8,1.4 M8,3.2 L10.2,1.4 M8,12.8 L5.8,14.6 M8,12.8 L10.2,14.6 M4.4,6 L4.2,3.4 M4.4,6 L2,6.4 M11.6,6 L11.8,3.4 M11.6,6 L14,6.4 M4.4,10 L4.2,12.6 M4.4,10 L2,9.6 M11.6,10 L11.8,12.6 M11.6,10 L14,9.6" />
              <Path x:Name="MusicParticle4" Width="11" Height="11" Stretch="Fill" Stroke="#FFE7E1FF" StrokeThickness="0.9" Opacity="0" RenderTransformOrigin="50%,50%"
                    Data="M8,0.7 L8,15.3 M1.7,4.5 L14.3,11.5 M14.3,4.5 L1.7,11.5 M8,3.2 L5.8,1.4 M8,3.2 L10.2,1.4 M8,12.8 L5.8,14.6 M8,12.8 L10.2,14.6 M4.4,6 L4.2,3.4 M4.4,6 L2,6.4 M11.6,6 L11.8,3.4 M11.6,6 L14,6.4 M4.4,10 L4.2,12.6 M4.4,10 L2,9.6 M11.6,10 L11.8,12.6 M11.6,10 L14,9.6" />
              <Path x:Name="MusicParticle5" Width="11" Height="11" Stretch="Fill" Stroke="#FFE7E1FF" StrokeThickness="0.9" Opacity="0" RenderTransformOrigin="50%,50%"
                    Data="M8,0.7 L8,15.3 M1.7,4.5 L14.3,11.5 M14.3,4.5 L1.7,11.5 M8,3.2 L5.8,1.4 M8,3.2 L10.2,1.4 M8,12.8 L5.8,14.6 M8,12.8 L10.2,14.6 M4.4,6 L4.2,3.4 M4.4,6 L2,6.4 M11.6,6 L11.8,3.4 M11.6,6 L14,6.4 M4.4,10 L4.2,12.6 M4.4,10 L2,9.6 M11.6,10 L11.8,12.6 M11.6,10 L14,9.6" />
            </Canvas>
            <StackPanel x:Name="TrackContent" IsVisible="False" Opacity="0" Spacing="3" MinWidth="176" MaxWidth="208"
                        HorizontalAlignment="Center" DragDrop.AllowDrop="True">
              <StackPanel.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.24" />
                </Transitions>
              </StackPanel.Transitions>
              <TextBlock x:Name="TrackTitle" Text="Music is playing" TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap" TextAlignment="Center" Foreground="#FF392B5A"
                         FontSize="12" FontWeight="Bold" MaxWidth="208" />
              <TextBlock x:Name="TrackArtist" Text="" TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap" TextAlignment="Center" Foreground="#FF665B78"
                         FontSize="11" MaxWidth="208" />
              <StackPanel x:Name="LyricsPanel" IsVisible="False" Spacing="1" MaxWidth="208" Margin="0,3,0,0">
              <TextBlock x:Name="LyricsCurrent" Text="" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                           MaxHeight="30" TextAlignment="Center" Foreground="#FF302047" FontSize="12"
                           FontWeight="Bold" />
                <TextBlock x:Name="LyricsNext" Text="" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                           MaxHeight="22" TextAlignment="Center" Foreground="#FF766C89" FontSize="10" Opacity="0.62" />
              </StackPanel>
              <Grid x:Name="TrackTimeline" IsVisible="False" Width="176" RowDefinitions="4,Auto" Margin="0,3,0,0">
                <Border x:Name="TrackProgressTrack" Grid.Row="0" Height="4" Background="#FFDAD7E3" CornerRadius="2"
                        HorizontalAlignment="Stretch" ClipToBounds="True">
                  <Border x:Name="TrackProgressFill" Width="0" HorizontalAlignment="Left" Background="#FF7969D4"
                          CornerRadius="2" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,2,0,0">
                  <TextBlock x:Name="TrackElapsed" Grid.Column="0" Text="0:00" FontSize="9"
                             Foreground="#FF665B78" HorizontalAlignment="Left" />
                  <TextBlock x:Name="TrackDuration" Grid.Column="1" Text="0:00" FontSize="9"
                             Foreground="#FF665B78" HorizontalAlignment="Right" />
                </Grid>
              </Grid>
              <StackPanel x:Name="TrackButtons" IsVisible="False" Orientation="Horizontal" Spacing="5"
                          HorizontalAlignment="Center" Margin="0" Height="0" Opacity="0" ClipToBounds="True">
                <StackPanel.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.18" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                  </Transitions>
                </StackPanel.Transitions>
                <Button x:Name="PreviousTrackButton" Classes="music-transport" Focusable="False" Click="OnPreviousTrackClick"
                        ToolTip.Tip="{DynamicResource companion.previous_track}"
                        AutomationProperties.Name="{DynamicResource companion.previous_track}">
                  <Canvas Width="18" Height="16" IsHitTestVisible="False">
                    <Border Canvas.Left="2" Canvas.Top="2" Width="2" Height="12" CornerRadius="1" Background="#FFFAF8FF" />
                    <Path Data="M14,2 L5,8 L14,14 Z" Fill="#FFFAF8FF" />
                  </Canvas>
                </Button>
                <Button x:Name="NextTrackButton" Classes="music-transport" Focusable="False" Click="OnNextTrackClick"
                        ToolTip.Tip="{DynamicResource companion.next_track}"
                        AutomationProperties.Name="{DynamicResource companion.next_track}">
                  <Canvas Width="18" Height="16" IsHitTestVisible="False">
                    <Path Data="M4,2 L13,8 L4,14 Z" Fill="#FFFAF8FF" />
                    <Border Canvas.Left="14" Canvas.Top="2" Width="2" Height="12" CornerRadius="1" Background="#FFFAF8FF" />
                  </Canvas>
                </Button>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
        <Ellipse Width="8" Height="8" Fill="#FFFDFEFF" Stroke="#FF6E58A8" StrokeThickness="1"
                 HorizontalAlignment="Center" />
      </StackPanel>
    </Popup>
  </Grid>
</Window>
